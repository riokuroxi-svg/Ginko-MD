# ⚠️ Copia este archivo a .env y pon TUS valores.
# NUNCA subas tu .env real a GitHub.

# Key de Google Gemini (gratis en https://aistudio.google.com)
GEMINI_API_KEY=tu_key_aqui

# (Opcional) Conexión a MongoDB Atlas - para cuando migres la DB
# MONGODB_URI=mongodb+srv://usuario:password@cluster.mongodb.net/ginko

# Número del bot (código de emparejamiento)
# BOT_NUMBER=521000000000
